{
  "name": "lightning-wolves-motion",
  "private": true,
  "version": "1.0.0",
  "description": "Lightning Wolves motion graphics — code-driven promo videos rendered with Remotion",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "studio": "npm run sync-assets && remotion studio src/index.ts",
    "render": "npm run sync-assets && node scripts/render-all.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/syncopate": "5.3.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
