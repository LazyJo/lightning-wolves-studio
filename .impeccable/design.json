  "narrative": {
    "northStar": "Lightning in the Dark",
    "overview": "The site is mostly calm, near-black space. Gold is the lightning: rare, sharp and always meaningful — it marks where the visitor acts, never where the interface wants attention. Everything around it stays quiet so that the artists, their faces and their music are what's loud.\n\nThe voice is premium and minimal, but the surfaces are tactile: buttons and cards are solid objects that lift and glow when touched, so the calm never feels flat or lifeless. Density is moderate — dashboards and the Studio can be busy, marketing pages breathe.",
    "keyCharacteristics": [
      "Near-black graphite layers, no light theme.",
      "One gold, used rarely: the primary action and genuine highlights.",
      "Per-surface accent colours identify where you are in the Studio.",
      "Uppercase, widely tracked Syncopate headings over plain Inter body.",
      "Solid, tactile components with hover lift and soft coloured glow."
    ],
    "rules": [
      {
        "name": "The Lightning Rule",
        "body": "Gold appears on at most one primary action per view plus genuine highlights (an award, the live state). Borders, badges, nav pills and decorative frames are neutral by default; if everything is gold, nothing is.",
        "section": "colors"
      },
      {
        "name": "The One Surface, One Accent Rule",
        "body": "A Studio surface uses only its own accent next to gold. Scenes is green, never cyan; Cover Art is cyan, never green.",
        "section": "colors"
      },
      {
        "name": "The Quiet Words Rule",
        "body": "Syncopate is for short headings only (≤ 8 words). Never set paragraphs, buttons with long labels or form text in it.",
        "section": "typography"
      },
      {
        "name": "The Glow Not Shadow Rule",
        "body": "Elevation on dark is expressed with coloured light. If a glow doesn't match the element's own accent, remove it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep gold to the primary action and real highlights (The Lightning Rule).",
      "Do give every clickable surface a tactile hover: lift and a glow in its own accent.",
      "Do use the surface's own accent in the Studio and the artist's colour on their profile.",
      "Do use `svh` for full-height sections and test at 375px and 1440px.",
      "Do respect `prefers-reduced-motion`: looping glows and floats stop.",
      "Do show prices and credits inline on CTAs, never only in a tooltip."
    ],
    "donts": [
      "Don't add gold borders, gold badges or gold nav pills by default.",
      "Don't use grey drop shadows on the black page; use tonal layers and glow.",
      "Don't set long text in Syncopate or go dimmer than Dusk Lavender for readable text.",
      "Don't introduce a light theme or new neutrals outside this palette.",
      "Don't bring JAVEDA's or the LAZY JO UNIVERSE's styles into the main site, or these into them.",
      "Don't run more than one breathing/pulsing glow in a view."
    ]
  }
}
